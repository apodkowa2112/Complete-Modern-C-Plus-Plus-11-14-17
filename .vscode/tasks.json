{
    "tasks": [
        {
            "type": "shell",
            "label": "CMake build",
            "command": "cmake",
            "args": [
                "--build",
                "build-cmake",
                "-j4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the workspace through the existing CMake configuration."
        },
        {
            "type": "shell",
            "label": "CMake build active file",
            "command": "python3",
            "args": [
                "${workspaceFolder}/.vscode/resolve_active_cmake_target.py",
                "${file}",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "detail": "Resolve the nearest CMakeLists.txt for the active editor file and build the corresponding target."
        },
        {
            "type": "shell",
            "label": "CMake run active file",
            "command": "python3",
            "args": [
                "${workspaceFolder}/.vscode/resolve_active_cmake_target.py",
                "${file}",
                "run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Resolve the nearest CMakeLists.txt for the active editor file, build the target, and run its binary."
        },
        {
            "type": "shell",
            "label": "CMake prepare active debug",
            "command": "python3",
            "args": [
                "${workspaceFolder}/.vscode/resolve_active_cmake_target.py",
                "${file}",
                "prepare-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "detail": "Build the active file's CMake target and select it for the root debugger."
        }
    ],
    "version": "2.0.0"
}